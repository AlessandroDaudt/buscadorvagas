# Local execution is mandatory by default. No external API key is required.
LOCAL_ONLY="true"

# Use http://localhost:11434 for a host Python install. Compose overrides this
# with the private service name http://ollama:11434.
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_CHAT_MODEL="qwen3:8b"
OLLAMA_EMBEDDING_MODEL="qwen3-embedding:0.6b"
OLLAMA_CPU_ONLY="false"

# Candidate configuration (overrides config.json)
CANDIDATE_NAME="Your Name"
RESUME_PATH="resume/YOUR_RESUME.md"
MIN_SCORE="60"
TOP_N="5"

# Local web panel (no login). This optional secret signs the local CSRF
# session and temporary download links.
PANEL_SESSION_SECRET="replace_with_at_least_32_random_bytes"
PANEL_ALLOWED_HOSTS="localhost,127.0.0.1"
PANEL_SECURE_COOKIE="false"
PANEL_HOST="127.0.0.1"
PANEL_PORT="8000"

# Scheduler and observability
SCHEDULER_RETRIES="1"
SCHEDULER_POLL_SECONDS="30"
# Set to false to run scheduled scans without the public-portal discovery cycle.
AUTOPILOT_DISCOVERY_ON_SCHEDULE="true"
AUTO_IMPORT_PORTAL_CATALOG="true"
PORTAL_CATALOG_RECUR_INTERVAL_SECONDS="60"
PORTAL_CATALOG_ACTIVATION_LIMIT="120"
# Prevent long SQLite writers and bound expensive AI reviews per scan.
AUTOPILOT_SQLITE_BUSY_TIMEOUT_MS="60000"
AUTOPILOT_DB_INGEST_BATCH_SIZE="50"
AUTOPILOT_AI_REVIEW_LIMIT="50"
LOG_FORMAT="json"
LOG_LEVEL="INFO"
LOG_FILE="scan.log"
