# TinyFish API — get yours at https://agent.tinyfish.ai
TINYFISH_API_KEY="your_tinyfish_api_key_here"

# Database (optional; SQLite is used by default)
# DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/autopilot"

# OpenRouter API — free tier available at https://openrouter.ai
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
OPENROUTER_FALLBACK_MODELS="nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,qwen/qwen3-coder:free"

# Anthropic / Claude (optional — alternative to OpenRouter)
# Set llm_provider=anthropic in config.json to use Claude instead of OpenRouter
# ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# OpenAI / Gemini / local OpenAI-compatible providers (optional)
# OPENAI_API_KEY="your_openai_api_key_here"
# OPENAI_MODEL="gpt-5.6-sol"
# GEMINI_API_KEY="your_gemini_api_key_here"
# LOCAL_LLM_API_KEY="optional_local_key"

# Telegram Notification (optional — create bot via @BotFather)
TELEGRAM_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"
# Generate with at least 32 random bytes; authenticates inline action payloads
TELEGRAM_CALLBACK_SECRET="replace_with_a_long_random_secret"

# Candidate Configuration (overrides config.json)
CANDIDATE_NAME="Your Name"
RESUME_PATH="resume/YOUR_RESUME.md"
MIN_SCORE=60
TOP_N=5

# Secure web panel
PANEL_USERNAME="admin"
PANEL_PASSWORD_HASH="replace_with_autopilot_panel_hash-password_output"
PANEL_SESSION_SECRET="replace_with_at_least_32_random_bytes"
PANEL_ALLOWED_HOSTS="localhost,127.0.0.1"
PANEL_SECURE_COOKIE="false"
PANEL_HOST="127.0.0.1"
PANEL_PORT="8000"
